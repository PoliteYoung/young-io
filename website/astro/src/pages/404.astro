---
import BaseLayout from '../layouts/BaseLayout.astro';
import { notFoundCopy } from '../i18n/not-found';
const { en, zh } = notFoundCopy;
---
<BaseLayout title={en.title} description={en.description} locale="en" noindex>
  <script is:inline>
    const { pathname } = window.location;
    if (pathname !== '/' && pathname.endsWith('/')) {
      // Keep the destination on this origin, even for repeated leading slashes.
      const destination = new URL(window.location.href);
      destination.pathname = pathname.replace(/\/+$/, '') || '/';
      window.location.replace(destination.href);
    }
  </script>
  <main class="not-found shell">
    <p class="section-number">404 / {en.label}</p>
    <p class="not-found-code" aria-hidden="true">404<span>↗</span></p>
    <div class="not-found-copy">
      <div lang="en"><h1>{en.heading}</h1><p>{en.detail}</p></div>
      <div lang="zh-CN"><p class="section-number">{zh.label}</p><h2>{zh.heading}</h2><p>{zh.detail}</p></div>
    </div>
    <nav class="hero-actions" aria-label={en.description}>
      <a class="button button-primary" href="/" lang="en">{en.home}<span aria-hidden="true">↗</span></a>
      <a class="button button-primary" href="/zh" lang="zh-CN">{zh.home}<span aria-hidden="true">↗</span></a>
    </nav>
  </main>
</BaseLayout>

<style>
  .not-found { min-height: 100svh; padding-block: clamp(36px, 6vw, 80px); color: var(--ink); }
  .not-found-code { display: flex; justify-content: space-between; align-items: center; margin-block: 24px 40px; border-bottom: 1px solid var(--ink); font: 800 clamp(110px, 19vw, 260px)/1 var(--display); letter-spacing: -.08em; }
  .not-found-code span { color: var(--ink); background: var(--acid); font-size: .5em; padding: .12em .25em; letter-spacing: 0; }
  .not-found-copy { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .not-found-copy h1, .not-found-copy h2 { margin-block: 12px 16px; font: 700 clamp(26px, 3.5vw, 48px)/1.15 var(--display); letter-spacing: -.04em; }
  .not-found-copy p:not(.section-number) { max-width: 36em; line-height: 1.7; }
  .not-found .hero-actions { flex-wrap: wrap; gap: 16px; }
  .not-found .button { justify-content: space-between; gap: 24px; }
  @media (max-width: 600px) {
    .not-found-copy { grid-template-columns: 1fr; gap: 28px; }
    .not-found-code { margin-bottom: 28px; font-size: clamp(76px, 23vw, 110px); }
    .not-found .hero-actions { align-items: stretch; }
    .not-found .button { width: 100%; }
  }
</style>
