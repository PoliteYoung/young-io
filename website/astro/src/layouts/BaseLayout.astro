---
import '../styles/global.css';
import type { Locale } from '../i18n/home';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  alternatePath?: string;
  bodyClass?: string;
}

const { title, description, locale, alternatePath = '/', bodyClass } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const normalizedPath = alternatePath === '/' ? '' : alternatePath;
const englishUrl = new URL(normalizedPath || '/', Astro.site);
const chineseUrl = new URL(`/zh${normalizedPath}`, Astro.site);
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10100f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
    <script is:inline>
      document.documentElement.classList.add('js');

      // A manual language choice must take precedence over Cloudflare's regional default.
      // Store it in both localStorage (for the browser) and a cookie (for edge rules).
      const url = new URL(window.location.href);
      const selectedLanguage = url.searchParams.get('lang');
      if (selectedLanguage === 'en' || selectedLanguage === 'zh') {
        try {
          localStorage.setItem('youngio-language', selectedLanguage);
        } catch {}
        document.cookie = `youngio_language=${selectedLanguage}; Max-Age=31536000; Path=/; SameSite=Lax; Secure`;
        url.searchParams.delete('lang');
        history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      }

      const elements = document.querySelectorAll('[data-reveal]');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.14 });
      elements.forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
