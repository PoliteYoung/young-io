---
import BaseLayout from './BaseLayout.astro';
import Header, { type PageKey } from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPublicIdentity } from '../lib/knowledge';
import type { Locale } from '../i18n/types';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  activePage: PageKey;
  alternatePath?: string;
  home?: boolean;
}

const { title, description, locale, activePage, alternatePath = '/', home = false } = Astro.props;
const { profile, brand } = await getPublicIdentity(locale);
---
<BaseLayout
  title={title}
  description={description}
  locale={locale}
  alternatePath={alternatePath}
  bodyClass={home ? 'site-page site-page--home' : 'site-page site-page--inner'}
>
  <div class="site-frame">
    <Header brand={brand.name} locale={locale} activePage={activePage} />
    <main class="site-main">
      <slot />
    </main>
    <Footer name={profile.displayName} email={profile.links.email} website={profile.links.website} locale={locale} />
  </div>
</BaseLayout>
