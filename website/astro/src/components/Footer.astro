---
import type { Locale } from '../i18n/types';
import { homeCopy } from '../i18n/home';

interface Props {
  name: string;
  email: { label: string; url: string };
  website: { label: string; url: string };
  locale: Locale;
}
const { name, email, website, locale } = Astro.props;
const copy = homeCopy[locale];
---
<footer id="contact" class="site-footer" transition:name="site-footer" transition:animate="none">
  <div>
    <p class="eyebrow">{copy.footerEyebrow}</p>
    <h2>{copy.footerTitle[0]}<br />{copy.footerTitle[1]}</h2>
  </div>
  <div class="footer-meta">
    <p>{copy.footerDescription(name)}</p>
    <div class="footer-links">
      <a href={email.url} aria-label={`${copy.footerEmailLabel}: ${email.label}`}>{email.label} ↗</a>
      <a href={website.url}>{website.label} ↗</a>
    </div>
    <p class="copyright">© {new Date().getFullYear()} · {copy.copyright}</p>
  </div>
</footer>
