---
import type { Locale } from '../i18n/types';
import { homeCopy } from '../i18n/home';

export type PageKey = 'home' | 'research' | 'publications' | 'experience';

interface Props {
  brand: string;
  locale: Locale;
  activePage: PageKey;
}

const { brand, locale, activePage } = Astro.props;
const copy = homeCopy[locale];
const localeBase = locale === 'zh' ? '/zh' : '';
const routes: Array<{ key: PageKey; label: string; path: string }> = [
  { key: 'home', label: copy.nav.home, path: '' },
  { key: 'research', label: copy.nav.research, path: '/research' },
  { key: 'publications', label: copy.nav.publications, path: '/publications' },
  { key: 'experience', label: copy.nav.experience, path: '/experience' },
];
const currentPath = routes.find((route) => route.key === activePage)?.path ?? '';
const languageHref = locale === 'zh'
  ? `${currentPath || '/'}?lang=en`
  : `/zh${currentPath}?lang=zh`;
const routeHref = (path: string) => `${localeBase}${path}` || '/';
---
<header class="site-header" transition:name="site-header" transition:animate="none">
  <a class="wordmark" href={routeHref('')} aria-label={`${brand} ${copy.nav.home}`}>
    <span>{brand.replace('.io', '')}</span><i>.io</i>
  </a>
  <nav aria-label={copy.primaryNavigationLabel}>
    {routes.map((route) => (
      <a href={routeHref(route.path)} aria-current={route.key === activePage ? 'page' : undefined}>{route.label}</a>
    ))}
  </nav>
  <div class="header-tools">
    <span class="status"><span></span> {copy.status}</span>
    <a class="language-switch" href={languageHref} lang={locale === 'zh' ? 'en' : 'zh-CN'} hreflang={locale === 'zh' ? 'en' : 'zh-CN'} aria-label={copy.languageLabel}>
      <span>{copy.languageShort}</span><i aria-hidden="true">↗</i>
    </a>
  </div>
</header>
