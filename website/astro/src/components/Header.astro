---
import type { Locale } from '../i18n/home';
import { homeCopy } from '../i18n/home';

interface Props {
  brand: string;
  locale: Locale;
}

const { brand, locale } = Astro.props;
const copy = homeCopy[locale];
const base = locale === 'zh' ? '/zh' : '';
const languageHref = locale === 'zh' ? '/?lang=en' : '/zh?lang=zh';
const links = [
  [copy.nav.home, 'home'],
  [copy.nav.research, 'research'],
  [copy.nav.projects, 'projects'],
  [copy.nav.publications, 'publications'],
  [copy.nav.experience, 'experience'],
  [copy.nav.writing, 'writing'],
] as const;
---
<header class="site-header">
  <a class="wordmark" href={base || '/'} aria-label={`${brand} ${copy.nav.home}`}>
    <span>{brand.replace('.io', '')}</span><i>.io</i>
  </a>
  <nav aria-label={locale === 'zh' ? '主导航' : 'Primary navigation'}>
    {links.map(([label, id], index) => <a href={index === 0 ? (base || '/') : `${base}#${id}`} aria-current={index === 0 ? 'page' : undefined}>{label}</a>)}
  </nav>
  <div class="header-tools">
    <a class="status" href="#contact"><span></span> {copy.status}</a>
    <a class="language-switch" href={languageHref} lang={locale === 'zh' ? 'en' : 'zh-CN'} hreflang={locale === 'zh' ? 'en' : 'zh-CN'} aria-label={copy.languageLabel}>
      <span>{copy.languageShort}</span><i aria-hidden="true">↗</i>
    </a>
  </div>
</header>
