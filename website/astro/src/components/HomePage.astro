---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPublicIdentity } from '../lib/knowledge';
import { homeCopy } from '../i18n/home';
import type { Locale } from '../i18n/types';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = homeCopy[locale];
const { profile, brand } = await getPublicIdentity(locale);
const profileTagKeys = ['email', 'github', 'linkedin', 'orcid', 'scholar', 'openreview'] as const;
const profileTags = [
  ...profileTagKeys.map((key) => ({
    key,
    label: copy.profileTags[key],
    value: key === 'email'
      ? profile.links.email.label
      : key === 'github' || key === 'linkedin'
      ? `@${profile.links[key].label}`
      : key === 'scholar'
        ? copy.profileTags.scholarValue
        : key === 'openreview'
          ? copy.profileTags.openreviewValue
          : profile.links[key].label,
    url: profile.links[key].url,
    external: key !== 'email',
  })),
  {
    key: 'resume',
    label: copy.profileTags.resume,
    value: '',
    url: locale === 'zh' ? '/zh/resume' : '/resume',
    external: false,
  },
];
const synthesis = profile.synthesis.map((item) => item.label);
const affiliation = profile.affiliation;
const [brandStem, brandSuffix] = brand.name.split('.', 2);
const localeBase = locale === 'zh' ? '/zh' : '';
const directory = [
  { index: '02', path: '/research', label: copy.nav.research, title: copy.sections.researchTitle, description: copy.sections.researchIntro },
  { index: '03', path: '/publications', label: copy.nav.publications, title: copy.sections.publicationsTitle, description: copy.sections.publicationsIntro },
  { index: '04', path: '/experience', label: copy.nav.experience, title: copy.sections.educationTitle, description: copy.sections.educationIntro },
];
---
<SiteLayout
  title={`${profile.displayName} — ${profile.headline}`}
  description={profile.positioning}
  locale={locale}
  activePage="home"
  home
>
  <section class="hero shell">
    <div class="hero-index" aria-hidden="true">{copy.heroIndex}</div>
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">{copy.heroEyebrow[0]} <span>↔</span> {copy.heroEyebrow[1]}</p>
      <div class="affiliation-lockup" aria-label={`${affiliation.role} · ${affiliation.institution}`}>
        <span class="affiliation-code">{affiliation.shortName}</span>
        <span class="affiliation-divider" aria-hidden="true"></span>
        <span class="affiliation-name"><strong>{affiliation.institution}</strong><small>{affiliation.role} · {affiliation.field}</small></span>
      </div>
      <h1>{profile.heroTitle[0]}<br /><span>{profile.heroTitle[1]}</span></h1>
      <p class="hero-intro">{profile.introduction}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={`${localeBase}/research`}>{copy.explore} <span>↗</span></a>
      </div>
      <nav class="profile-tags" aria-label={copy.profileTags.label}>
        {profileTags.map((link) => (
          <a class:list={["profile-tag", `profile-tag--${link.key}`]} href={link.url} target={link.external ? "_blank" : undefined} rel={link.external ? "me noopener noreferrer" : undefined} aria-label={`${link.label}: ${link.value}`}>
            <span class="profile-tag-icon" aria-hidden="true">
              {link.key === 'email' && <svg viewBox="0 0 24 24" role="img"><path d="M3 5h18v14H3V5Zm2 2v.45l7 5.25 7-5.25V7H5Zm14 10V9.95l-7 5.25-7-5.25V17h14Z" /></svg>}
              {link.key === 'github' && <svg viewBox="0 0 24 24" role="img"><path d="M12 .7A11.5 11.5 0 0 0 8.36 23.1c.58.1.79-.25.79-.56v-2.23c-3.24.7-3.92-1.38-3.92-1.38-.53-1.35-1.3-1.71-1.3-1.71-1.06-.73.08-.72.08-.72 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.4-1.27.74-1.56-2.59-.29-5.31-1.29-5.31-5.7 0-1.26.45-2.29 1.2-3.1-.12-.3-.52-1.48.11-3.07 0 0 .98-.32 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.07.75.81 1.2 1.84 1.2 3.1 0 4.43-2.73 5.4-5.32 5.7.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>}
              {link.key === 'linkedin' && <svg viewBox="0 0 24 24" role="img"><path d="M5.35 7.9H1.8V22h3.55V7.9ZM3.57 2A2.07 2.07 0 1 0 3.6 6.13 2.07 2.07 0 0 0 3.57 2ZM22.2 13.92c0-4.24-2.26-6.21-5.28-6.21a4.57 4.57 0 0 0-4.15 2.28V7.9H9.22V22h3.55v-6.99c0-1.84.35-3.63 2.64-3.63 2.25 0 2.28 2.11 2.28 3.75V22h3.55l.96-8.08Z" /></svg>}
              {link.key === 'orcid' && <span class="profile-tag-letter">iD</span>}
              {link.key === 'scholar' && <svg viewBox="0 0 24 24" role="img"><path d="m12 2 10 5.4-4.1 2.2v5.75h-1.7v-4.83L12 12.8 2 7.4 12 2Zm-6.4 8.15L12 13.6l6.4-3.45v6.1c0 1.58-2.87 3.65-6.4 3.65s-6.4-2.07-6.4-3.65v-6.1Z" /></svg>}
              {link.key === 'openreview' && <span class="profile-tag-letter">OR</span>}
              {link.key === 'resume' && <svg viewBox="0 0 24 24" role="img"><path d="M5 2h10l4 4v16H5V2Zm9 1.7V7h3.3L14 3.7ZM8 11v1.5h8V11H8Zm0 4v1.5h8V15H8Zm0 4v1h5v-1H8Z" /></svg>}
            </span>
            <span class="profile-tag-copy"><b>{link.label}</b>{link.value && <span>{link.value}</span>}</span>
            <i aria-hidden="true">↗</i>
          </a>
        ))}
      </nav>
    </div>
    <figure class="portrait-card">
      <div class="portrait-grid" aria-hidden="true"></div><div class="portrait-orbit" aria-hidden="true"></div>
      <img src="/images/yaodong-yang-portrait.jpg" alt={copy.portraitAlt} width="853" height="1280" loading="eager" fetchpriority="high" decoding="async" />
      <figcaption><span class="portrait-id">{copy.portraitId}</span><span class="portrait-name">{profile.displayName}</span><span class="portrait-role">{affiliation.role}<br />{affiliation.institution}</span></figcaption>
      <div class="portrait-synthesis" aria-label={synthesis.join('、')}>{synthesis.map((item, index) => <span>{String(index + 1).padStart(2, '0')} / {item}</span>)}</div>
    </figure>
  </section>

  <section class="manifesto shell" data-reveal>
    <p class="section-number">{copy.sections.position}</p>
    <div><p class="manifesto-lead">{profile.position.lead}</p><h2>{profile.position.lines[0]}<br />{profile.position.lines[1]}<br /><em>{profile.position.lines[2]}</em></h2></div>
  </section>

  <section class="page-directory shell" aria-label={copy.directoryLabel}>
    <div class="directory-heading" data-reveal>
      <p class="section-number">{copy.directoryNumber}</p>
      <h2>{copy.directoryTitle}</h2>
    </div>
    <div class="directory-list">
      {directory.map((item) => (
        <a class="directory-row" href={`${localeBase}${item.path}`} data-reveal>
          <span class="directory-index">{item.index}</span>
          <div><p>{item.label}</p><h3>{item.title[0]} {item.title[1]}</h3><small>{item.description}</small></div>
          <span class="directory-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="identity-strip">
    <div class="shell strip-inner">
      <div class="identity-wordmark"><strong>{brandStem.toUpperCase()}<span>.{brandSuffix.toUpperCase()}</span></strong></div>
    </div>
  </section>
</SiteLayout>
