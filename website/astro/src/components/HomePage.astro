---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getPublicKnowledge } from '../lib/knowledge';
import { capabilityZh, educationZh, homeCopy, publicationZh, type Locale } from '../i18n/home';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = homeCopy[locale];
const { profile, brand, capabilities, education, publications } = await getPublicKnowledge();
const formatPeriod = (value: string | Date | null) => {
  if (!value) return copy.present;
  const text = value instanceof Date ? value.toISOString().slice(0, 10) : String(value);
  return text.slice(0, 7);
};
const displayName = locale === 'zh' ? profile.name.display_zh : profile.name.display;
const profileTagKeys = ['github', 'linkedin', 'orcid', 'scholar'] as const;
const profileTags = profileTagKeys.map((key) => ({
  key,
  label: copy.profileTags[key],
  value: key === 'scholar' ? copy.profileTags.scholarValue : profile.links[key].label,
  url: profile.links[key].url,
}));
const knownAuthorNames = new Set([profile.name.display, ...profile.name.alternatives]);
const formatAuthor = (author: string) => knownAuthorNames.has(author) ? displayName : author;
const synthesis = locale === 'zh' ? ['研究', '工程', '基础设施'] : profile.synthesis;
const affiliation = locale === 'zh'
  ? { institution: profile.affiliation.institution_zh, role: copy.affiliationRole, field: '计算媒体与艺术' }
  : { institution: profile.affiliation.institution, role: profile.affiliation.role, field: profile.affiliation.field };
---
<BaseLayout title={`${displayName} — ${copy.titleHeadline}`} description={copy.description} locale={locale}>
  <main>
    <Header brand={brand.name} locale={locale} />

    <section class="hero shell" id="home">
      <div class="hero-index" aria-hidden="true">{copy.heroIndex}</div>
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">{copy.heroEyebrow[0]} <span>↔</span> {copy.heroEyebrow[1]}</p>
        <div class="affiliation-lockup" aria-label={`${affiliation.role} · ${affiliation.institution}`}>
          <span class="affiliation-code">{copy.affiliationCode}</span>
          <span class="affiliation-divider" aria-hidden="true"></span>
          <span class="affiliation-name"><strong>{affiliation.institution}</strong><small>{affiliation.role} · {affiliation.field}</small></span>
        </div>
        <h1>
          {copy.heroTitle[0]}<br />
          <span>{copy.heroTitle[1]}</span>
        </h1>
        <p class="hero-intro">{copy.heroIntro}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#research">{copy.explore} <span>↓</span></a>
        </div>
        <nav class="profile-tags" aria-label={copy.profileTags.label}>
          {profileTags.map((link) => (
            <a class:list={["profile-tag", `profile-tag--${link.key}`]} href={link.url} target="_blank" rel="me noopener noreferrer" aria-label={`${link.label}: ${link.value}`}>
              <span class="profile-tag-icon" aria-hidden="true">
                {link.key === 'github' && (
                  <svg viewBox="0 0 24 24" role="img"><path d="M12 .7A11.5 11.5 0 0 0 8.36 23.1c.58.1.79-.25.79-.56v-2.23c-3.24.7-3.92-1.38-3.92-1.38-.53-1.35-1.3-1.71-1.3-1.71-1.06-.73.08-.72.08-.72 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.4-1.27.74-1.56-2.59-.29-5.31-1.29-5.31-5.7 0-1.26.45-2.29 1.2-3.1-.12-.3-.52-1.48.11-3.07 0 0 .98-.32 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.07.75.81 1.2 1.84 1.2 3.1 0 4.43-2.73 5.4-5.32 5.7.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
                )}
                {link.key === 'linkedin' && (
                  <svg viewBox="0 0 24 24" role="img"><path d="M5.35 7.9H1.8V22h3.55V7.9ZM3.57 2A2.07 2.07 0 1 0 3.6 6.13 2.07 2.07 0 0 0 3.57 2ZM22.2 13.92c0-4.24-2.26-6.21-5.28-6.21a4.57 4.57 0 0 0-4.15 2.28V7.9H9.22V22h3.55v-6.99c0-1.84.35-3.63 2.64-3.63 2.25 0 2.28 2.11 2.28 3.75V22h3.55l.96-8.08Z" /></svg>
                )}
                {link.key === 'orcid' && <span class="profile-tag-letter">iD</span>}
                {link.key === 'scholar' && (
                  <svg viewBox="0 0 24 24" role="img"><path d="m12 2 10 5.4-4.1 2.2v5.75h-1.7v-4.83L12 12.8 2 7.4 12 2Zm-6.4 8.15L12 13.6l6.4-3.45v6.1c0 1.58-2.87 3.65-6.4 3.65s-6.4-2.07-6.4-3.65v-6.1Z" /></svg>
                )}
              </span>
              <span class="profile-tag-copy"><b>#{link.label}</b><span>{link.value}</span></span>
              <i aria-hidden="true">↗</i>
            </a>
          ))}
        </nav>
      </div>
      <figure class="portrait-card">
        <div class="portrait-grid" aria-hidden="true"></div>
        <div class="portrait-orbit" aria-hidden="true"></div>
        <img
          src="/images/yaodong-yang-portrait.jpg"
          alt={copy.portraitAlt}
          width="853"
          height="1280"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>
          <span class="portrait-id">{copy.portraitId}</span>
          <span class="portrait-name">{displayName}</span>
          <span class="portrait-role">{affiliation.role}<br />{affiliation.institution}</span>
        </figcaption>
        <div class="portrait-synthesis" aria-label={synthesis.join('、')}>
          {synthesis.map((item, index) => <span>{String(index + 1).padStart(2, '0')} / {item}</span>)}
        </div>
      </figure>
      <div class="scroll-note">{copy.scroll} <span>↓</span></div>
    </section>

    <section class="manifesto shell" data-reveal>
      <p class="section-number">{copy.sections.position}</p>
      <div>
        <p class="manifesto-lead">{copy.sections.positionLead}</p>
        <h2>{copy.sections.positionLines[0]}<br />{copy.sections.positionLines[1]}<br /><em>{copy.sections.positionLines[2]}</em></h2>
      </div>
    </section>

    <section class="domains shell" id="research">
      <div class="section-heading" data-reveal>
        <div>
          <p class="section-number">{copy.sections.research}</p>
          <h2>{copy.sections.researchTitle[0]}<br />{copy.sections.researchTitle[1]}</h2>
        </div>
        <p>{copy.sections.researchIntro}</p>
      </div>
      <div class="domain-list">
        {capabilities.map((domain, index) => {
          const translated = locale === 'zh' ? capabilityZh[domain.id] : null;
          return (
            <article class="domain-row" data-reveal>
              <div class="domain-number">{String(index + 1).padStart(2, '0')}</div>
              <div class="domain-title">
                <h3>{translated?.title ?? domain.title}</h3>
                <p>{translated?.summary ?? domain.summary}</p>
              </div>
              <ul>{(translated?.topics ?? domain.topics).map((topic) => <li>{topic}</li>)}</ul>
              <span class="domain-arrow">↗</span>
            </article>
          );
        })}
      </div>
    </section>

    <section class="project-field shell" id="projects" data-reveal>
      <div class="field-graphic" aria-hidden="true">
        <span class="axis axis-x"></span><span class="axis axis-y"></span>
        <div class="human human-a"></div><div class="human human-b"></div><div class="human human-c"></div>
        <span class="point p1"></span><span class="point p2"></span><span class="point p3"></span><span class="point p4"></span>
      </div>
      <div class="field-copy">
        <p class="section-number">{copy.sections.projects}</p>
        <h2>{copy.sections.projectsTitle}</h2>
        <p>{copy.sections.projectsIntro}</p>
        <span class="verification-chip">{copy.sections.projectsStatus}</span>
      </div>
    </section>

    <section class="publications shell" id="publications">
      <div class="section-heading compact" data-reveal>
        <div>
          <p class="section-number">{copy.sections.publications}</p>
          <h2>{copy.sections.publicationsTitle[0]}<br />{copy.sections.publicationsTitle[1]}</h2>
        </div>
        <p>{copy.sections.publicationsIntro}</p>
      </div>
      <div class="publication-list">
        {publications.map((publication, index) => {
          const translated = locale === 'zh' ? publicationZh[publication.id] : null;
          return (
            <a class="publication-row" href={publication.links.primary} target="_blank" rel="noopener noreferrer" data-reveal>
              <span class="publication-index">{String(index + 1).padStart(2, '0')}</span>
              <div><h3>{translated?.title ?? publication.title}</h3><p>{translated?.authors ?? publication.authors.map(formatAuthor).join(' · ')}</p></div>
              <div class="publication-meta"><strong>{publication.year}</strong><span>{translated?.venue ?? publication.venue}</span><i>{copy.publicationLink}</i></div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="education shell" id="experience">
      <div class="section-heading compact" data-reveal>
        <div><p class="section-number">{copy.sections.education}</p><h2>{copy.sections.educationTitle[0]}<br />{copy.sections.educationTitle[1]}</h2></div>
        <p>{copy.sections.educationIntro}</p>
      </div>
      <div class="education-list">
        {education.map((item, index) => {
          const translated = locale === 'zh' ? educationZh[item.id] : null;
          return (
            <article class="education-row" data-reveal>
              <span class="education-index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{translated?.institution ?? item.institution}</h3>
                <p>{translated?.degree ?? item.degree}{(translated?.field ?? item.field) ? ` · ${translated?.field ?? item.field}` : ''}</p>
                {(translated?.school ?? item.school) && <small>{translated?.school ?? item.school}</small>}
              </div>
              <div class="education-period"><strong>{formatPeriod(item.period.start)}</strong><span>→</span><strong>{formatPeriod(item.period.end ?? null)}</strong></div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="writing shell" id="writing" data-reveal>
      <p class="section-number">{copy.sections.writing}</p>
      <div class="writing-title"><h2>{copy.sections.writingTitle}</h2><p>{copy.sections.writingIntro}</p></div>
      <div class="empty-note"><span>{copy.sections.writingEmpty}</span><p>{copy.sections.writingEmptyDetail}</p></div>
    </section>

    <section class="identity-strip">
      <div class="shell strip-inner">
        <div class="binary" aria-hidden="true">{copy.identityTicker}</div>
        <div class="identity-copy">
          <p>{copy.identityMeanings[0]}</p>
          <strong>YOUNG<span>.IO</span></strong>
          <p>{copy.identityMeanings[1]}</p>
        </div>
      </div>
    </section>

    <Footer name={displayName} website={profile.links.website.label} locale={locale} />
  </main>
</BaseLayout>
